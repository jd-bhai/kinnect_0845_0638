<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:background="@drawable/border_rectangle"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@android:color/transparent"
                android:contentDescription="Back"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/left_arrow" />

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:text="Omar Farooq"
                android:textColor="#222222"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnSearch"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@android:color/transparent"
                android:contentDescription="Search"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/search" />
        </LinearLayout>

        <!-- Cover Photo & Avatar Section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="6dp"
            android:background="@color/white">

            <ImageView
                android:id="@+id/ivCoverPhoto"
                android:layout_width="match_parent"
                android:layout_height="135dp"
                android:contentDescription="Cover Photo"
                android:scaleType="centerCrop"
                android:src="@drawable/default_gallery" />

            <!-- Profile Avatar Circle Container -->
            <LinearLayout
                android:id="@+id/jw"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/circle"
                android:backgroundTint="@color/white"
                android:gravity="center"
                android:padding="4dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ivProfilePicture"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Profile Picture"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvInitialsAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/circle"
                        android:backgroundTint="#0B5F63"
                        android:gravity="center"
                        android:text="OF"
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                </RelativeLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- Details & Bio -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <TextView
                android:id="@+id/tvFullName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Omar Farooq"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="834 friends - 38 Mutual"
                android:textColor="#65676B"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvBio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Night Photographer. Karachi after dark."
                android:textColor="@color/black"
                android:textSize="15sp" />

            <!-- Action Buttons Row (+ Add friend, Message, Menu) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnAddFriend"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="3"
                    android:background="#0B5F63"
                    android:gravity="center"
                    android:text="+ Add friend"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnMessage"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="3"
                    android:background="#E0E0E0"
                    android:drawableStart="@drawable/messenger"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="Message"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:layout_width="42dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_rounded_card"
                    android:backgroundTint="#eaeaea"
                    android:contentDescription="Menu"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/meatballs_menu" />
            </LinearLayout>

            <!-- Mutual Friends Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <RelativeLayout
                    android:layout_width="80dp"
                    android:layout_height="32dp">

                    <TextView
                        android:id="@+id/like"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/circle"
                        android:backgroundTint="@color/brown"
                        android:gravity="center"
                        android:text="AK"
                        android:textColor="@color/white"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/heart"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_toEndOf="@id/like"
                        android:background="@drawable/circle"
                        android:backgroundTint="@color/purple"
                        android:gravity="center"
                        android:text="LM"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:translationX="-8dp" />

                    <TextView
                        android:id="@+id/emoji"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_toEndOf="@id/heart"
                        android:background="@drawable/circle"
                        android:backgroundTint="#0B5F63"
                        android:gravity="center"
                        android:text="OF"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:translationX="-16dp" />
                </RelativeLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Friends with Aisha khan, Lina Marsh and 36 others"
                    android:textColor="@color/black"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Information / Details Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="10dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Work"
                    android:scaleType="fitCenter"
                    android:src="@drawable/work" />

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email: user\@mail.com"
                    android:textColor="@color/black"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="10dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Gender"
                    android:scaleType="fitCenter"
                    android:src="@drawable/outline_person_24" />

                <TextView
                    android:id="@+id/tvGender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gender: Male"
                    android:textColor="@color/black"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="10dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Website"
                    android:scaleType="fitCenter"
                    android:src="@drawable/globe" />

                <TextView
                    android:id="@+id/tvWebsite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Website: Not set"
                    android:textColor="#0B5F63"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Target User Posts Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Posts"
                android:textColor="#1C1E21"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#E4E6EB" />

            <TextView
                android:id="@+id/tvNoPosts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No posts uploaded yet."
                android:textColor="#65676B"
                android:textSize="14sp"
                android:visibility="visible" />

            <LinearLayout
                android:id="@+id/containerUserPosts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
