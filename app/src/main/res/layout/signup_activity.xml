<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F0EA"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Section (Back Arrow, Screen Title, Step Indicator) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/left_arrow" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Create account"
            android:textColor="#1C1E21"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 2 of 3"
            android:textColor="#65676B"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Top Step Progress Bar (3 Segmented Indicator Bars) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="#0B5F63" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="#0B5F63" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#D1D5DB" />

    </LinearLayout>

    <!-- Main Section Header & Profile Photo Picker Anchor -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="What's your name and birthday?"
            android:textColor="#1C1E21"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp">

            <ImageView
                android:id="@+id/ivProfilePic"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/circle"
                android:backgroundTint="#E4E6EB"
                android:padding="10dp"
                android:src="@drawable/outline_person_24" />

            <ImageView
                android:id="@+id/btnAddPhoto"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:background="@drawable/circle"
                android:backgroundTint="#0B5F63"
                android:padding="4dp"
                android:src="@drawable/camera" />

        </RelativeLayout>

    </LinearLayout>

    <!-- Name Fields Container (First Name & Last Name) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_rounded_card"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="First name"
                android:textColor="#65676B"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etFirstName"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="Jacob"
                android:inputType="textPersonName"
                android:textColor="#1C1E21"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_rounded_card"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Last name"
                android:textColor="#65676B"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etLastName"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="West"
                android:inputType="textPersonName"
                android:textColor="#1C1E21"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Birthday Dropdowns Container (Day, Month, Year) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Birthday"
            android:textColor="#1C1E21"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal">

            <!-- Day Picker -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_rounded_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Day"
                        android:textColor="#65676B"
                        android:textSize="10sp" />

                    <EditText
                        android:id="@+id/etBirthDay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="14"
                        android:inputType="number"
                        android:maxLength="2"
                        android:textColor="#1C1E21"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/outline_arrow_drop_down_24" />
            </LinearLayout>

            <!-- Month Picker -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_rounded_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Month"
                        android:textColor="#65676B"
                        android:textSize="10sp" />

                    <EditText
                        android:id="@+id/etBirthMonth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="Mar"
                        android:inputType="text"
                        android:maxLength="3"
                        android:textColor="#1C1E21"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/outline_arrow_drop_down_24" />
            </LinearLayout>

            <!-- Year Picker -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_rounded_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Year"
                        android:textColor="#65676B"
                        android:textSize="10sp" />

                    <EditText
                        android:id="@+id/etBirthYear"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="2004"
                        android:inputType="number"
                        android:maxLength="4"
                        android:textColor="#1C1E21"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/outline_arrow_drop_down_24" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Gender Selector Container -->
    <!-- Gender Selector Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Gender"
            android:textColor="#1C1E21"
            android:textSize="12sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgGender"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbFemale"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_rounded_card"
                android:gravity="center_vertical"
                android:layoutDirection="rtl"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Female"
                android:textColor="#1C1E21"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbMale"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_rounded_card"
                android:checked="true"
                android:gravity="center_vertical"
                android:layoutDirection="rtl"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Male"
                android:textColor="#1C1E21"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbCustom"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_rounded_card"
                android:gravity="center_vertical"
                android:layoutDirection="rtl"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Custom"
                android:textColor="#1C1E21"
                android:textSize="13sp" />

        </RadioGroup>

    </LinearLayout>

    <!-- Email Field -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_rounded_card"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textColor="#65676B"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/etSignupEmail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:gravity="center_vertical"
            android:hint="jacob.west@mail.com"
            android:inputType="textEmailAddress"
            android:textColor="#1C1E21"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- New Password Field -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_rounded_card"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="New password"
                android:textColor="#65676B"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etSignupPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="••••••••"
                android:inputType="textPassword"
                android:textColor="#1C1E21"
                android:textSize="14sp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnToggleSignupPassword"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical"
            android:background="@android:color/transparent"
            android:contentDescription="Toggle password"
            android:scaleType="fitCenter"
            android:src="@drawable/view" />

    </LinearLayout>

    <!-- Dynamic Password Strength Indicator Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/strengthBar1"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#D1D5DB" />

        <View
            android:id="@+id/strengthBar2"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#D1D5DB" />

        <View
            android:id="@+id/strengthBar3"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="#D1D5DB" />

        <TextView
            android:id="@+id/tvStrengthLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="60dp"
            android:text="Weak"
            android:textColor="#65676B"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Terms and Policy Checkbox -->
    <CheckBox
        android:id="@+id/cbTerms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="I agree to the Kinnect Terms and Privacy Policy."
        android:textColor="#1C1E21"
        android:textSize="12sp" />

    <!-- Create Account Button -->
    <TextView
        android:id="@+id/createAccountButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_button_teal"
        android:gravity="center"
        android:text="Create account"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Navigation Link Back to Login -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already have an account? "
            android:textColor="#65676B"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/loginText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="Log in"
            android:textColor="#0B5F63"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>