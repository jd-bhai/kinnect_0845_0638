<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="8.5"
        android:layout_margin="8dp">

        <ImageView
            android:id="@+id/storyMediaPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/default_gallery"
            android:scaleType="centerCrop" />

        <!-- Tools Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/closeButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/circle"
                android:backgroundTint="#80000000"
                android:scaleType="fitCenter"
                android:padding="10dp"
                android:src="@drawable/close"
                android:tint="@color/white" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/addContact"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/circle"
                android:backgroundTint="#80000000"
                android:scaleType="fitCenter"
                android:padding="10dp"
                android:src="@drawable/addcontact"
                android:tint="@color/white" />

            <TextView
                android:id="@+id/typeBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/circle"
                android:backgroundTint="#80000000"
                android:gravity="center"
                android:text="Aa"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/emojiBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/circle"
                android:backgroundTint="#80000000"
                android:scaleType="fitCenter"
                android:padding="10dp"
                android:src="@drawable/face"
                android:tint="@color/white" />

            <ImageButton
                android:id="@+id/musicBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/circle"
                android:backgroundTint="#80000000"
                android:scaleType="fitCenter"
                android:padding="10dp"
                android:src="@drawable/music"
                android:tint="@color/white" />

            <ImageButton
                android:id="@+id/starBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/circle"
                android:backgroundTint="#80000000"
                android:scaleType="fitCenter"
                android:padding="10dp"
                android:src="@drawable/star"
                android:tint="@color/white" />
        </LinearLayout>

        <!-- Editable Story Caption Tag -->
        <EditText
            android:id="@+id/captionInput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="#C0B55F63"
            android:hint="Saturday plans"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:textColor="@color/white"
            android:textColorHint="#E0FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Bottom Publishing Options -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="12dp">

        <LinearLayout
            android:id="@+id/yourStory"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_button_outline"
            android:backgroundTint="#2F2F2F"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <TextView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/circle"
                android:backgroundTint="#0B5F63"
                android:gravity="center"
                android:text="JW"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Your story"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/closeFriends"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_button_outline"
            android:backgroundTint="#2F2F2F"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/circle"
                android:backgroundTint="#0B5F63"
                android:padding="5dp"
                android:src="@drawable/star"
                android:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Close friends"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/nextButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/circle"
            android:backgroundTint="#0B5F63"
            android:padding="12dp"
            android:rotation="-90"
            android:scaleType="fitCenter"
            android:src="@drawable/outline_arrow_downward_24"
            android:tint="@color/white" />
    </LinearLayout>
</LinearLayout>