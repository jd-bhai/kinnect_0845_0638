<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_voice_call"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B5F63">

    <!-- Center Content: Avatar, Name, Timer -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Large Rounded Square Avatar with Purple Background -->
        <FrameLayout
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:background="@drawable/bg_rounded_card"
            android:backgroundTint="#6A4C6D"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_user_initials"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="AM"
                android:textColor="#FFFFFF"
                android:textSize="48sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Receiver Name -->
        <TextView
            android:id="@+id/tv_user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Ammi ❤️"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Live Call Duration Timer -->
        <TextView
            android:id="@+id/tv_call_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="00:00"
            android:textColor="#D1E8E6"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Bottom Controls Row matching UI PDF -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="24dp">

        <!-- Switch to Video Button -->
        <ImageButton
            android:id="@+id/btn_switch_to_video"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/circle"
            android:backgroundTint="#248085"
            android:contentDescription="Video"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/camera"
            app:tint="#FFFFFF" />

        <!-- Mute Audio Button -->
        <ImageButton
            android:id="@+id/btn_mute"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/circle"
            android:backgroundTint="#248085"
            android:contentDescription="Mute"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/microphone"
            app:tint="#FFFFFF" />

        <!-- End Call Button (Large Red Circle) -->
        <ImageButton
            android:id="@+id/btn_end_call"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/circle"
            android:backgroundTint="#D93025"
            android:contentDescription="End Call"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/close"
            app:tint="#FFFFFF" />

        <!-- Speakerphone Button -->
        <ImageButton
            android:id="@+id/btn_speaker"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/circle"
            android:backgroundTint="#248085"
            android:contentDescription="Speaker"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/speaker"
            app:tint="#FFFFFF" />
    </LinearLayout>

</RelativeLayout>